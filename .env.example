# ==============================================================================
# Verstats — Variables de Entorno y Configuración (Plantilla de Ejemplo)
# ==============================================================================
# NOTA: Este archivo es una plantilla pública de referencia.
# Para configuración local, crea una copia llamada `.env` (ignorado en git).
# ==============================================================================

# Entorno y URLs
NODE_ENV=production
SITE_URL=https://verstats.es

# Datos de Contacto y Operativa
CONTACT_PHONE=34XXXXXXXXX
CONTACT_EMAIL=info@verstats.es
WHATSAPP_LINK=https://wa.me/34XXXXXXXXX

# Cloudflare Workers Assets
CLOUDFLARE_PROJECT_NAME=verstats
CLOUDFLARE_COMPATIBILITY_DATE=2026-08-28

# Integraciones Futuras (Opcionales)
# CLOUDFLARE_D1_DATABASE_ID=
# GOOGLE_MAPS_API_KEY=
# ANALYTICS_ID=
